{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-agent.local/schemas/sandbox-tool-v1.json",
  "title": "Sandbox execute tool",
  "type": "object",
  "additionalProperties": false,
  "required": ["argv"],
  "properties": {
    "argv": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"type": "string", "maxLength": 4096}
    },
    "timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 5}
  }
}

