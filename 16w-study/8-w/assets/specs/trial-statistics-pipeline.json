  ],
  "nodes": [
    {"id": "suite", "kind": "document", "x": 70, "y": 140, "width": 170, "height": 58, "label": "Task Suite", "sublabel": "task + split + weights", "fill": "#eff6ff", "stroke": "#3b82f6", "flat": true},
    {"id": "versions", "kind": "rect", "x": 315, "y": 140, "width": 190, "height": 58, "label": "Version Manifest", "sublabel": "model + prompt + graders", "fill": "#fff7ed", "stroke": "#f97316", "flat": true},
    {"id": "snapshot", "kind": "cylinder", "x": 590, "y": 140, "width": 200, "height": 58, "label": "Environment Snapshot", "sublabel": "corpus + clock + state", "fill": "#ecfdf5", "stroke": "#10b981"},
    {"id": "trial-batch", "kind": "double_rect", "x": 620, "y": 300, "width": 200, "height": 60, "label": "Trial 1 … k", "sublabel": "fresh isolated namespaces", "fill": "#faf5ff", "stroke": "#8b5cf6", "flat": true},
    {"id": "trial-results", "kind": "document", "x": 350, "y": 300, "width": 190, "height": 60, "label": "Trial Results", "sublabel": "success + trace + outcome", "fill": "#eff6ff", "stroke": "#3b82f6", "flat": true},
    {"id": "task-estimate", "kind": "double_rect", "x": 80, "y": 300, "width": 190, "height": 60, "label": "Per-Task Estimate", "sublabel": "within-task variance", "fill": "#f0fdfa", "stroke": "#14b8a6", "flat": true},
    {"id": "bootstrap", "kind": "rect", "x": 80, "y": 468, "width": 210, "height": 62, "label": "Paired Hierarchical Bootstrap", "sublabel": "tasks, then trials", "fill": "#fff7ed", "stroke": "#f97316", "flat": true},
    {"id": "decision", "kind": "double_rect", "x": 390, "y": 468, "width": 210, "height": 62, "label": "Estimate + CI + Gate", "sublabel": "effect, risk, uncertainty", "fill": "#fff1f2", "stroke": "#fb7185", "flat": true}
